<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ai_provider_list" model="ir.ui.view">
        <field name="name">ai.provider.list</field>
        <field name="model">ai.provider</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="provider_type"/>
                <field name="model"/>
                <field name="is_default"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_ai_provider_form" model="ir.ui.view">
        <field name="name">ai.provider.form</field>
        <field name="model">ai.provider</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Production Claude"/></h1>
                    </div>
                    <group>
                        <group string="Model">
                            <field name="provider_type"/>
                            <field name="model"/>
                            <field name="api_base_url" placeholder="Leave empty for provider default"/>
                            <field name="api_key" password="True"/>
                        </group>
                        <group string="Behaviour">
                            <field name="is_default"/>
                            <field name="temperature"/>
                            <field name="max_tokens"/>
                            <field name="max_tool_rounds"/>
                            <field name="request_timeout"/>
                            <field name="default_language"/>
                            <field name="response_style"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="System Instructions">
                        <field name="system_instructions" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ai_provider" model="ir.actions.act_window">
        <field name="name">AI Providers</field>
        <field name="res_model">ai.provider</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>

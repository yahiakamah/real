<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ai_conversation_list" model="ir.ui.view">
        <field name="name">ai.conversation.list</field>
        <field name="model">ai.conversation</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="user_id"/>
                <field name="message_count"/>
                <field name="last_message_date"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_ai_conversation_form" model="ir.ui.view">
        <field name="name">ai.conversation.form</field>
        <field name="model">ai.conversation</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <field name="user_id"/>
                        <field name="provider_id"/>
                        <field name="last_message_date"/>
                    </group>
                    <field name="message_ids">
                        <list>
                            <field name="create_date"/>
                            <field name="role"/>
                            <field name="content"/>
                            <field name="execution_time"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ai_conversation" model="ir.actions.act_window">
        <field name="name">Conversations</field>
        <field name="res_model">ai.conversation</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>

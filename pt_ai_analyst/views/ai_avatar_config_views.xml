<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ai_avatar_config_form" model="ir.ui.view">
        <field name="name">ai.avatar.config.form</field>
        <field name="model">ai.avatar.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <field name="avatar_mode" widget="radio"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group string="Voice (text-to-speech)">
                        <field name="tts_mode" widget="radio"/>
                        <field name="tts_provider" invisible="tts_mode != 'server'"/>
                        <field name="tts_api_base"
                               invisible="tts_mode != 'server' or tts_provider != 'openai'"
                               placeholder="http://host.docker.internal:8000/v1"/>
                        <field name="tts_model"
                               invisible="tts_mode != 'server' or tts_provider != 'openai'"/>
                        <field name="tts_api_key" password="True"
                               invisible="tts_mode != 'server'"
                               placeholder="Google: required · Local: optional"/>
                        <field name="tts_voice_ar" invisible="tts_mode != 'server'"/>
                        <field name="tts_voice_en" invisible="tts_mode != 'server'"/>
                        <div class="text-muted" colspan="2"
                             invisible="tts_mode != 'server'">
                            Google: enable Cloud Text-to-Speech on your project (you can
                            often reuse the Gemini key). Local: point the Base URL at an
                            OpenAI-compatible speech server (Piper / Kokoro /
                            openedai-speech) for a fully offline Arabic voice.
                        </div>
                    </group>
                    <group string="HeyGen (realtime video avatar)"
                           invisible="avatar_mode != 'heygen'">
                        <field name="heygen_api_key" password="True"
                               placeholder="hg_..."/>
                        <field name="heygen_avatar_id"
                               placeholder="e.g. Wayne_20240711"/>
                        <field name="heygen_voice_id" placeholder="optional"/>
                        <field name="heygen_quality"/>
                        <div class="text-muted" colspan="2">
                            The API key is used only on the server to mint a
                            short-lived streaming token; it is never exposed to the
                            browser. HeyGen streaming requires network access to
                            HeyGen and may need its domains allowed in your CSP.
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ai_avatar_config" model="ir.actions.act_window">
        <field name="name">Avatar</field>
        <field name="res_model">ai.avatar.config</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{}</field>
    </record>

    <!-- Open the singleton directly -->
    <record id="action_ai_avatar_config_open" model="ir.actions.server">
        <field name="name">Avatar</field>
        <field name="model_id" ref="model_ai_avatar_config"/>
        <field name="state">code</field>
        <field name="code">
cfg = env['ai.avatar.config'].get_config()
action = {
    'type': 'ir.actions.act_window',
    'res_model': 'ai.avatar.config',
    'view_mode': 'form',
    'res_id': cfg.id,
    'target': 'current',
}
        </field>
    </record>

</odoo>

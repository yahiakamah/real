<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ai_audit_list" model="ir.ui.view">
        <field name="name">ai.audit.log.list</field>
        <field name="model">ai.audit.log</field>
        <field name="arch" type="xml">
            <list default_order="create_date desc"
                  decoration-danger="success == False">
                <field name="create_date"/>
                <field name="user_id"/>
                <field name="question"/>
                <field name="models_accessed"/>
                <field name="tool_calls"/>
                <field name="execution_time"/>
                <field name="success"/>
            </list>
        </field>
    </record>

    <record id="view_ai_audit_form" model="ir.ui.view">
        <field name="name">ai.audit.log.form</field>
        <field name="model">ai.audit.log</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="create_date"/>
                            <field name="success"/>
                            <field name="execution_time"/>
                        </group>
                        <group>
                            <field name="models_accessed"/>
                            <field name="tool_calls"/>
                            <field name="conversation_id"/>
                        </group>
                    </group>
                    <group string="Question">
                        <field name="question" nolabel="1"/>
                    </group>
                    <group string="Error" invisible="success == True">
                        <field name="error_message" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ai_audit" model="ir.actions.act_window">
        <field name="name">Audit Log</field>
        <field name="res_model">ai.audit.log</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>

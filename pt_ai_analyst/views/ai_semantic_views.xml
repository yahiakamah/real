<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ai_semantic_model_list" model="ir.ui.view">
        <field name="name">ai.semantic.model.list</field>
        <field name="model">ai.semantic.model</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="model_name"/>
                <field name="date_field"/>
                <field name="field_count"/>
                <field name="ai_enabled" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_ai_semantic_model_form" model="ir.ui.view">
        <field name="name">ai.semantic.model.form</field>
        <field name="model">ai.semantic.model</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_discover_fields" type="object"
                            string="Discover Fields" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="model_id"/>
                            <field name="model_name" invisible="1"/>
                            <field name="ai_enabled"/>
                            <field name="date_field"
                                   placeholder="e.g. create_date, date_order"/>
                        </group>
                        <group>
                            <field name="default_domain"
                                   placeholder="e.g. [('state','!=','cancel')]"/>
                        </group>
                    </group>
                    <group string="Business Meaning">
                        <field name="description" nolabel="1"
                               placeholder="Explain to the AI what this data represents..."/>
                    </group>
                    <notebook>
                        <page string="Fields">
                            <field name="field_ids">
                                <list editable="bottom">
                                    <field name="field_id"/>
                                    <field name="field_name"/>
                                    <field name="ttype"/>
                                    <field name="business_name"/>
                                    <field name="ai_enabled" widget="boolean_toggle"/>
                                    <field name="is_measure" widget="boolean_toggle"/>
                                    <field name="is_dimension" widget="boolean_toggle"/>
                                    <field name="is_sensitive" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ai_semantic_model" model="ir.actions.act_window">
        <field name="name">Semantic Layer</field>
        <field name="res_model">ai.semantic.model</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register a model for the AI</p>
            <p>Pick an Odoo model, click <b>Discover Fields</b>, then flag which
               fields are measures, dimensions or sensitive. The AI can only ever
               touch what you enable here.</p>
        </field>
    </record>

</odoo>

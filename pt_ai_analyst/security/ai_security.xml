<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="module_category_ai_analyst" model="ir.module.category">
            <field name="name">AI Analyst</field>
            <field name="sequence">20</field>
        </record>

        <record id="group_ai_user" model="res.groups">
            <field name="name">AI Analyst / User</field>
            <field name="category_id" ref="module_category_ai_analyst"/>
            <field name="comment">Can chat with the AI Analyst over the data they
                are already allowed to see in Odoo.</field>
        </record>

        <record id="group_ai_manager" model="res.groups">
            <field name="name">AI Analyst / Manager</field>
            <field name="category_id" ref="module_category_ai_analyst"/>
            <field name="implied_ids" eval="[(4, ref('group_ai_user'))]"/>
            <field name="comment">Can review all conversations and the audit log.</field>
        </record>

        <record id="group_ai_admin" model="res.groups">
            <field name="name">AI Analyst / Administrator</field>
            <field name="category_id" ref="module_category_ai_analyst"/>
            <field name="implied_ids" eval="[(4, ref('group_ai_manager'))]"/>
            <field name="comment">Can configure providers, the semantic layer and
                suggested questions.</field>
        </record>

        <!-- A user only ever sees their own conversations... -->
        <record id="rule_conversation_own" model="ir.rule">
            <field name="name">AI Conversation: own only</field>
            <field name="model_id" ref="model_ai_conversation"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_ai_user'))]"/>
        </record>

        <!-- ...unless they are a manager, who can see all. -->
        <record id="rule_conversation_manager" model="ir.rule">
            <field name="name">AI Conversation: manager sees all</field>
            <field name="model_id" ref="model_ai_conversation"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_ai_manager'))]"/>
        </record>

        <record id="rule_audit_manager" model="ir.rule">
            <field name="name">AI Audit: manager sees all</field>
            <field name="model_id" ref="model_ai_audit_log"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_ai_manager'))]"/>
        </record>

        <!-- Messages follow their conversation's ownership. -->
        <record id="rule_message_own" model="ir.rule">
            <field name="name">AI Message: own only</field>
            <field name="model_id" ref="model_ai_message"/>
            <field name="domain_force">[('conversation_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_ai_user'))]"/>
        </record>

        <record id="rule_message_manager" model="ir.rule">
            <field name="name">AI Message: manager sees all</field>
            <field name="model_id" ref="model_ai_message"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_ai_manager'))]"/>
        </record>

        <!-- Multi-company scoping on providers. -->
        <record id="rule_provider_company" model="ir.rule">
            <field name="name">AI Provider: company</field>
            <field name="model_id" ref="model_ai_provider"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>

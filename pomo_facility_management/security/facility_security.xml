<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_facility_management" model="ir.module.category">
            <field name="name">Facility Management</field>
            <field name="sequence">16</field>
        </record>

        <record id="group_facility_user" model="res.groups">
            <field name="name">Requester</field>
            <field name="category_id" ref="module_category_facility_management"/>
            <field name="comment">Can submit and follow up their own facility work orders.</field>
        </record>

        <record id="group_facility_technician" model="res.groups">
            <field name="name">Technician</field>
            <field name="category_id" ref="module_category_facility_management"/>
            <field name="implied_ids" eval="[(4, ref('group_facility_user'))]"/>
            <field name="comment">Can manage assets and work orders assigned to them.</field>
        </record>

        <record id="group_facility_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_facility_management"/>
            <field name="implied_ids" eval="[(4, ref('group_facility_technician'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
            <field name="comment">Full access: assets, work orders, maintenance plans and configuration.</field>
        </record>

        <!-- Record rules -->
        <record id="rule_facility_work_order_technician" model="ir.rule">
            <field name="name">Facility Work Order: technician sees assigned or unassigned</field>
            <field name="model_id" ref="model_facility_work_order"/>
            <field name="domain_force">['|', ('assigned_technician_id.id', '=', user.id), ('assigned_technician_id', '=', False)]</field>
            <field name="groups" eval="[(4, ref('group_facility_technician'))]"/>
        </record>

        <record id="rule_facility_work_order_manager" model="ir.rule">
            <field name="name">Facility Work Order: manager sees all</field>
            <field name="model_id" ref="model_facility_work_order"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_facility_manager'))]"/>
        </record>

        <record id="rule_facility_work_order_user" model="ir.rule">
            <field name="name">Facility Work Order: requester sees own requests</field>
            <field name="model_id" ref="model_facility_work_order"/>
            <field name="domain_force">[('requested_by_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('group_facility_user'))]"/>
        </record>

    </data>
</odoo>

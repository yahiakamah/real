<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="facility_asset_view_list" model="ir.ui.view">
        <field name="name">facility.asset.list</field>
        <field name="model">facility.asset</field>
        <field name="arch" type="xml">
            <list string="Assets" decoration-muted="state == 'decommissioned'"
                  decoration-warning="state == 'under_maintenance'"
                  decoration-danger="state == 'out_of_service'">
                <field name="code"/>
                <field name="name"/>
                <field name="project_id" optional="show"/>
                <field name="building_id"/>
                <field name="unit_id"/>
                <field name="category_id"/>
                <field name="asset_type"/>
                <field name="next_maintenance_date"/>
                <field name="in_warranty" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'operational'"
                       decoration-warning="state == 'under_maintenance'"
                       decoration-danger="state == 'out_of_service'"/>
            </list>
        </field>
    </record>

    <record id="facility_asset_view_kanban" model="ir.ui.view">
        <field name="name">facility.asset.kanban</field>
        <field name="model">facility.asset</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column">
                <field name="name"/>
                <field name="code"/>
                <field name="state"/>
                <field name="building_id"/>
                <field name="category_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click p-2">
                            <strong><field name="name"/></strong>
                            <div class="text-muted"><field name="code"/></div>
                            <div><field name="building_id"/></div>
                            <div><field name="category_id"/></div>
                            <span class="badge rounded-pill"
                                  t-attf-class="text-bg-{{ record.state.raw_value == 'operational' and 'success' or (record.state.raw_value == 'out_of_service' and 'danger' or 'warning') }}">
                                <field name="state"/>
                            </span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="facility_asset_view_form" model="ir.ui.view">
        <field name="name">facility.asset.form</field>
        <field name="model">facility.asset</field>
        <field name="arch" type="xml">
            <form string="Asset">
                <header>
                    <field name="state" widget="statusbar" clickable="true"
                           statusbar_visible="operational,under_maintenance,out_of_service"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_view_work_orders"
                                class="oe_stat_button" icon="fa-wrench" invisible="not id">
                            <field name="work_order_count" widget="statinfo" string="Work Orders"/>
                        </button>
                    </div>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Asset Name"/></h1>
                        <h3><field name="code" readonly="1"/></h3>
                    </div>
                    <group>
                        <group string="Location">
                            <field name="project_id"/>
                            <field name="building_id"/>
                            <field name="unit_id"/>
                            <field name="region_id"/>
                            <field name="location"/>
                        </group>
                        <group string="Classification">
                            <field name="category_id"/>
                            <field name="asset_type"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <group string="Vendor &amp; Warranty">
                            <field name="supplier_id"/>
                            <field name="brand"/>
                            <field name="model_number"/>
                            <field name="serial_number"/>
                            <field name="purchase_date"/>
                            <field name="warranty_end_date"/>
                            <field name="in_warranty" readonly="1"/>
                        </group>
                        <group string="Preventive Maintenance">
                            <field name="maintenance_frequency_days"/>
                            <field name="last_maintenance_date"/>
                            <field name="next_maintenance_date" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="facility_asset_view_search" model="ir.ui.view">
        <field name="name">facility.asset.search</field>
        <field name="model">facility.asset</field>
        <field name="arch" type="xml">
            <search string="Assets">
                <field name="name"/>
                <field name="code"/>
                <field name="project_id"/>
                <field name="building_id"/>
                <field name="unit_id"/>
                <field name="category_id"/>
                <filter string="Operational" name="operational" domain="[('state', '=', 'operational')]"/>
                <filter string="Under Maintenance" name="under_maintenance" domain="[('state', '=', 'under_maintenance')]"/>
                <filter string="Out of Service" name="out_of_service" domain="[('state', '=', 'out_of_service')]"/>
                <filter string="Under Warranty" name="in_warranty" domain="[('in_warranty', '=', True)]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Building" name="group_building" context="{'group_by': 'building_id'}"/>
                    <filter string="Category" name="group_category" context="{'group_by': 'category_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="facility_management_action_asset" model="ir.actions.act_window">
        <field name="name">Assets</field>
        <field name="res_model">facility.asset</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_operational': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register your first facility asset
            </p>
            <p>
                Track equipment and infrastructure (elevators, HVAC, pumps, generators, ...)
                per building or unit, with warranty and preventive maintenance schedules.
            </p>
        </field>
    </record>

</odoo>

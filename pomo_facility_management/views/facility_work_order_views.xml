<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="facility_work_order_view_list" model="ir.ui.view">
        <field name="name">facility.work.order.list</field>
        <field name="model">facility.work.order</field>
        <field name="arch" type="xml">
            <list string="Work Orders" decoration-danger="is_overdue" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="project_id" optional="show"/>
                <field name="building_id"/>
                <field name="unit_id"/>
                <field name="category_id"/>
                <field name="work_type"/>
                <field name="assigned_technician_id"/>
                <field name="request_date"/>
                <field name="sla_deadline"/>
                <field name="priority" widget="priority"/>
                <field name="is_overdue" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('new','assigned')"
                       decoration-warning="state in ('in_progress','on_hold')"
                       decoration-success="state == 'done'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="facility_work_order_view_kanban" model="ir.ui.view">
        <field name="name">facility.work.order.kanban</field>
        <field name="model">facility.work.order</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="building_id"/>
                <field name="unit_id"/>
                <field name="category_id"/>
                <field name="assigned_technician_id"/>
                <field name="priority"/>
                <field name="is_overdue"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click p-2 #{record.is_overdue.raw_value ? 'border border-danger' : ''}">
                            <div class="d-flex justify-content-between">
                                <strong><field name="name"/></strong>
                                <field name="priority" widget="priority"/>
                            </div>
                            <div><field name="building_id"/><t t-if="record.unit_id.raw_value"> - <field name="unit_id"/></t></div>
                            <div class="text-muted"><field name="category_id"/></div>
                            <div t-if="record.assigned_technician_id.raw_value">
                                <i class="fa fa-user-circle"/> <field name="assigned_technician_id"/>
                            </div>
                            <div t-if="record.is_overdue.raw_value" class="text-danger">
                                <i class="fa fa-exclamation-triangle"/> Overdue
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="facility_work_order_view_form" model="ir.ui.view">
        <field name="name">facility.work.order.form</field>
        <field name="model">facility.work.order</field>
        <field name="arch" type="xml">
            <form string="Work Order">
                <header>
                    <button name="action_assign" type="object" string="Assign"
                            class="btn-primary" invisible="state != 'new'"/>
                    <button name="action_start" type="object" string="Start"
                            class="btn-primary" invisible="state not in ('assigned','on_hold')"/>
                    <button name="action_hold" type="object" string="Hold"
                            invisible="state != 'in_progress'"/>
                    <button name="action_resume" type="object" string="Resume"
                            invisible="state != 'on_hold'"/>
                    <button name="action_complete" type="object" string="Mark Completed"
                            class="btn-primary" invisible="state not in ('in_progress','on_hold','assigned')"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('done','cancelled')"/>
                    <button name="action_reset_to_new" type="object" string="Reset to New"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,assigned,in_progress,done"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Overdue" bg_color="text-bg-danger" invisible="not is_overdue"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Location">
                            <field name="project_id"/>
                            <field name="building_id"/>
                            <field name="unit_id"/>
                            <field name="region_id"/>
                            <field name="asset_id"/>
                        </group>
                        <group string="Classification">
                            <field name="category_id"/>
                            <field name="work_type"/>
                            <field name="priority" widget="priority"/>
                            <field name="maintenance_plan_id" readonly="1" invisible="not maintenance_plan_id"/>
                            <field name="tenant_request_id" readonly="1" invisible="not tenant_request_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="People">
                            <field name="requested_by_id"/>
                            <field name="assigned_technician_id"/>
                        </group>
                        <group string="Schedule &amp; SLA">
                            <field name="request_date" readonly="1"/>
                            <field name="date_scheduled"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="sla_deadline" readonly="1"/>
                            <field name="is_overdue" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" nolabel="1" placeholder="Describe the issue or the maintenance to perform..."/>
                    </group>
                    <notebook>
                        <page string="Materials / Cost">
                            <field name="material_line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="unit_cost"/>
                                    <field name="subtotal" sum="Total"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="cost_estimate"/>
                                <field name="cost_actual" readonly="1"/>
                            </group>
                        </page>
                        <page string="Tenant Feedback" invisible="state != 'done'">
                            <group>
                                <field name="feedback_rating"/>
                                <field name="feedback_notes"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="facility_work_order_view_calendar" model="ir.ui.view">
        <field name="name">facility.work.order.calendar</field>
        <field name="model">facility.work.order</field>
        <field name="arch" type="xml">
            <calendar string="Work Orders" date_start="date_scheduled" color="category_id" mode="month">
                <field name="name"/>
                <field name="building_id"/>
                <field name="assigned_technician_id"/>
            </calendar>
        </field>
    </record>

    <record id="facility_work_order_view_pivot" model="ir.ui.view">
        <field name="name">facility.work.order.pivot</field>
        <field name="model">facility.work.order</field>
        <field name="arch" type="xml">
            <pivot string="Work Orders Analysis">
                <field name="building_id" type="row"/>
                <field name="category_id" type="row"/>
                <field name="state" type="col"/>
                <field name="cost_actual" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="facility_work_order_view_search" model="ir.ui.view">
        <field name="name">facility.work.order.search</field>
        <field name="model">facility.work.order</field>
        <field name="arch" type="xml">
            <search string="Work Orders">
                <field name="name"/>
                <field name="project_id"/>
                <field name="building_id"/>
                <field name="unit_id"/>
                <field name="category_id"/>
                <field name="assigned_technician_id"/>
                <field name="requested_by_id"/>
                <filter string="My Work Orders" name="my_work_orders" domain="[('assigned_technician_id', '=', uid)]"/>
                <filter string="Unassigned" name="unassigned" domain="[('assigned_technician_id', '=', False)]"/>
                <filter string="Overdue" name="overdue" domain="[('is_overdue', '=', True)]"/>
                <separator/>
                <filter string="New" name="state_new" domain="[('state', '=', 'new')]"/>
                <filter string="In Progress" name="state_in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Completed" name="state_done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter string="Preventive" name="type_preventive" domain="[('work_type', '=', 'preventive')]"/>
                <filter string="Corrective" name="type_corrective" domain="[('work_type', '=', 'corrective')]"/>
                <group expand="0" string="Group By">
                    <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="Building" name="group_building" context="{'group_by': 'building_id'}"/>
                    <filter string="Category" name="group_category" context="{'group_by': 'category_id'}"/>
                    <filter string="Technician" name="group_technician" context="{'group_by': 'assigned_technician_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="facility_management_action_work_order" model="ir.actions.act_window">
        <field name="name">Work Orders</field>
        <field name="res_model">facility.work.order</field>
        <field name="view_mode">kanban,list,calendar,pivot,form</field>
        <field name="context">{'search_default_state_new': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first facility work order
            </p>
            <p>
                Log maintenance requests and track them from request to completion,
                with SLA deadlines, technician assignment and cost tracking.
            </p>
        </field>
    </record>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════ LIST VIEW ═══════════════════════ -->
    <record id="facility_inspection_view_list" model="ir.ui.view">
        <field name="name">facility.inspection.list</field>
        <field name="model">facility.inspection</field>
        <field name="arch" type="xml">
            <list string="Inspections"
                  decoration-success="state == 'done'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="project_id" optional="show"/>
                <field name="building_id"/>
                <field name="unit_id" optional="show"/>
                <field name="inspection_type"/>
                <field name="inspector_id" widget="many2one_avatar_user"/>
                <field name="date_planned"/>
                <field name="overall_rating" optional="hide"/>
                <field name="pass_rate" widget="progressbar" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('draft','scheduled')"
                       decoration-warning="state == 'in_progress'"
                       decoration-success="state == 'done'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════════════ KANBAN VIEW ═══════════════════════ -->
    <record id="facility_inspection_view_kanban" model="ir.ui.view">
        <field name="name">facility.inspection.kanban</field>
        <field name="model">facility.inspection</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="building_id"/>
                <field name="inspection_type"/>
                <field name="inspector_id"/>
                <field name="date_planned"/>
                <field name="overall_rating"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click p-2">
                            <div class="d-flex justify-content-between">
                                <strong><field name="name"/></strong>
                                <span t-if="record.overall_rating.raw_value"
                                      class="badge rounded-pill"
                                      t-attf-class="text-bg-#{record.overall_rating.raw_value == 'excellent' ? 'success' : (record.overall_rating.raw_value == 'critical' ? 'danger' : 'warning')}">
                                    <field name="overall_rating"/>
                                </span>
                            </div>
                            <div><field name="building_id"/></div>
                            <div class="text-muted"><field name="inspection_type"/></div>
                            <div>
                                <i class="fa fa-calendar"/> <field name="date_planned"/>
                            </div>
                            <div>
                                <i class="fa fa-user"/> <field name="inspector_id"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ═══════════════════════ FORM VIEW ═══════════════════════ -->
    <record id="facility_inspection_view_form" model="ir.ui.view">
        <field name="name">facility.inspection.form</field>
        <field name="model">facility.inspection</field>
        <field name="arch" type="xml">
            <form string="Inspection">
                <header>
                    <button name="action_schedule" type="object"
                            string="Schedule" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_start" type="object"
                            string="Start Inspection" class="btn-primary"
                            invisible="state != 'scheduled'"/>
                    <button name="action_complete" type="object"
                            string="Complete" class="btn-success"
                            invisible="state != 'in_progress'"/>
                    <button name="action_cancel" type="object"
                            string="Cancel"
                            invisible="state in ('done','cancelled')"/>
                    <button name="action_reset_draft" type="object"
                            string="Reset to Draft"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,scheduled,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Location">
                            <field name="project_id"/>
                            <field name="building_id"/>
                            <field name="unit_id"/>
                            <field name="region_id"/>
                        </group>
                        <group string="Inspection Details">
                            <field name="inspection_type"/>
                            <field name="inspector_id" widget="many2one_avatar_user"/>
                            <field name="tenant_id"/>
                            <field name="date_planned"/>
                            <field name="date_done" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Results">
                            <field name="overall_rating"/>
                            <field name="pass_rate" widget="progressbar"/>
                            <field name="pass_count"/>
                            <field name="fail_count"/>
                            <field name="total_items"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Checklist">
                            <field name="checklist_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="category_id"/>
                                    <field name="result" widget="badge"
                                           decoration-success="result == 'pass'"
                                           decoration-danger="result == 'fail'"
                                           decoration-muted="result == 'na'"/>
                                    <field name="notes"/>
                                    <field name="photo" widget="image"
                                           options="{'size': [64, 64]}"/>
                                </list>
                            </field>
                        </page>
                        <page string="Findings &amp; Recommendations">
                            <group>
                                <field name="finding_notes"
                                       placeholder="Document findings and observations..."/>
                            </group>
                            <group>
                                <field name="recommendation"
                                       placeholder="Recommendations for improvement..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════ CALENDAR VIEW ═══════════════════════ -->
    <record id="facility_inspection_view_calendar" model="ir.ui.view">
        <field name="name">facility.inspection.calendar</field>
        <field name="model">facility.inspection</field>
        <field name="arch" type="xml">
            <calendar string="Inspections" date_start="date_planned"
                      color="inspection_type" mode="month">
                <field name="name"/>
                <field name="building_id"/>
                <field name="inspector_id"/>
            </calendar>
        </field>
    </record>

    <!-- ═══════════════════════ SEARCH VIEW ═══════════════════════ -->
    <record id="facility_inspection_view_search" model="ir.ui.view">
        <field name="name">facility.inspection.search</field>
        <field name="model">facility.inspection</field>
        <field name="arch" type="xml">
            <search string="Inspections">
                <field name="name"/>
                <field name="project_id"/>
                <field name="building_id"/>
                <field name="unit_id"/>
                <field name="inspector_id"/>
                <filter string="My Inspections" name="my_inspections"
                        domain="[('inspector_id', '=', uid)]"/>
                <separator/>
                <filter string="Draft" name="state_draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Scheduled" name="state_scheduled"
                        domain="[('state', '=', 'scheduled')]"/>
                <filter string="Completed" name="state_done"
                        domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter string="Pre-Handover" name="type_pre_handover"
                        domain="[('inspection_type', '=', 'pre_handover')]"/>
                <filter string="Safety" name="type_safety"
                        domain="[('inspection_type', '=', 'safety')]"/>
                <group expand="0" string="Group By">
                    <filter string="Project" name="group_project"
                            context="{'group_by': 'project_id'}"/>
                    <filter string="Building" name="group_building"
                            context="{'group_by': 'building_id'}"/>
                    <filter string="Type" name="group_type"
                            context="{'group_by': 'inspection_type'}"/>
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Inspector" name="group_inspector"
                            context="{'group_by': 'inspector_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ═══════════════════════ ACTION ═══════════════════════ -->
    <record id="facility_management_action_inspection" model="ir.actions.act_window">
        <field name="name">Inspections</field>
        <field name="res_model">facility.inspection</field>
        <field name="view_mode">kanban,list,calendar,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Schedule your first property inspection
            </p>
            <p>
                Conduct routine, pre-handover, safety, and annual inspections
                with detailed checklists and findings documentation.
            </p>
        </field>
    </record>

</odoo>

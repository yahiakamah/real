<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="facility_tenant_request_view_list" model="ir.ui.view">
        <field name="name">facility.tenant.request.list</field>
        <field name="model">facility.tenant.request</field>
        <field name="arch" type="xml">
            <list string="Tenant Requests"
                  decoration-success="state in ('resolved','closed')"
                  decoration-muted="state == 'rejected'">
                <field name="name"/>
                <field name="tenant_id"/>
                <field name="project_id" optional="show"/>
                <field name="building_id"/>
                <field name="unit_id"/>
                <field name="category_id"/>
                <field name="priority" widget="priority"/>
                <field name="create_date" string="Submitted On"/>
                <field name="work_order_id" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'submitted'"
                       decoration-warning="state == 'acknowledged'"
                       decoration-primary="state == 'work_order_created'"
                       decoration-success="state in ('resolved','closed')"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="facility_tenant_request_view_kanban" model="ir.ui.view">
        <field name="name">facility.tenant.request.kanban</field>
        <field name="model">facility.tenant.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="tenant_id"/>
                <field name="building_id"/>
                <field name="category_id"/>
                <field name="priority"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click p-2">
                            <div class="d-flex justify-content-between">
                                <strong><field name="name"/></strong>
                                <field name="priority" widget="priority"/>
                            </div>
                            <div><i class="fa fa-user"/> <field name="tenant_id"/></div>
                            <div><field name="building_id"/></div>
                            <div class="text-muted"><field name="category_id"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="facility_tenant_request_view_form" model="ir.ui.view">
        <field name="name">facility.tenant.request.form</field>
        <field name="model">facility.tenant.request</field>
        <field name="arch" type="xml">
            <form string="Tenant Request">
                <header>
                    <button name="action_acknowledge" type="object" string="Acknowledge" class="btn-primary" invisible="state != 'submitted'"/>
                    <button name="action_create_work_order" type="object" string="Create Work Order" class="btn-primary" invisible="state != 'acknowledged'"/>
                    <button name="action_resolve" type="object" string="Mark Resolved" class="btn-success" invisible="state != 'work_order_created'"/>
                    <button name="action_close" type="object" string="Close" invisible="state != 'resolved'"/>
                    <button name="action_reject" type="object" string="Reject" invisible="state in ('work_order_created','resolved','closed','rejected')"/>
                    <field name="state" widget="statusbar" statusbar_visible="submitted,acknowledged,work_order_created,resolved,closed"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group string="Tenant Information">
                            <field name="tenant_id"/>
                            <field name="tenant_phone"/>
                            <field name="tenant_email" widget="email"/>
                        </group>
                        <group string="Location">
                            <field name="project_id"/>
                            <field name="building_id"/>
                            <field name="unit_id"/>
                            <field name="region_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Request Details">
                            <field name="category_id"/>
                            <field name="priority" widget="priority"/>
                            <field name="preferred_date"/>
                        </group>
                        <group string="Work Order" invisible="not work_order_id">
                            <field name="work_order_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Describe the issue..." nolabel="1"/>
                    </group>
                    <group>
                        <field name="photo" widget="image" class="oe_avatar"/>
                    </group>
                    <notebook invisible="state not in ('resolved','closed')">
                        <page string="Resolution">
                            <group>
                                <field name="resolution_notes"/>
                                <field name="satisfaction_rating"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="facility_tenant_request_view_search" model="ir.ui.view">
        <field name="name">facility.tenant.request.search</field>
        <field name="model">facility.tenant.request</field>
        <field name="arch" type="xml">
            <search string="Tenant Requests">
                <field name="name"/>
                <field name="tenant_id"/>
                <field name="building_id"/>
                <field name="category_id"/>
                <filter string="Pending" name="pending" domain="[('state', 'in', ('submitted','acknowledged'))]"/>
                <filter string="In Progress" name="in_progress" domain="[('state', '=', 'work_order_created')]"/>
                <filter string="Resolved" name="resolved" domain="[('state', 'in', ('resolved','closed'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="Building" name="group_building" context="{'group_by': 'building_id'}"/>
                    <filter string="Category" name="group_category" context="{'group_by': 'category_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="facility_management_action_tenant_request" model="ir.actions.act_window">
        <field name="name">Tenant Requests</field>
        <field name="res_model">facility.tenant.request</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No tenant requests yet</p>
            <p>Tenants submit maintenance requests here. Acknowledge, create work orders, and track resolution.</p>
        </field>
    </record>

</odoo>

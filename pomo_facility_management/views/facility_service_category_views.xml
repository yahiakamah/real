<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="facility_service_category_view_list" model="ir.ui.view">
        <field name="name">facility.service.category.list</field>
        <field name="model">facility.service.category</field>
        <field name="arch" type="xml">
            <list string="Service Categories" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="default_priority"/>
                <field name="response_time_hours"/>
                <field name="work_order_count"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="facility_service_category_view_form" model="ir.ui.view">
        <field name="name">facility.service.category.form</field>
        <field name="model">facility.service.category</field>
        <field name="arch" type="xml">
            <form string="Service Category">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_view_work_orders"
                                class="oe_stat_button" icon="fa-wrench"
                                invisible="not id">
                            <field name="work_order_count" widget="statinfo" string="Work Orders"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="default_priority"/>
                            <field name="response_time_hours"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="facility_management_action_service_category" model="ir.actions.act_window">
        <field name="name">Service Categories</field>
        <field name="res_model">facility.service.category</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>

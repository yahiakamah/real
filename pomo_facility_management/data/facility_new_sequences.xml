<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="seq_facility_inspection" model="ir.sequence">
        <field name="name">Facility Inspection</field>
        <field name="code">facility.inspection</field>
        <field name="prefix">INS/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_facility_vendor_contract" model="ir.sequence">
        <field name="name">Facility Vendor Contract</field>
        <field name="code">facility.vendor.contract</field>
        <field name="prefix">VC/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_facility_tenant_request" model="ir.sequence">
        <field name="name">Facility Tenant Request</field>
        <field name="code">facility.tenant.request</field>
        <field name="prefix">TR/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
